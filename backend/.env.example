# Copy to backend/.env (git-ignored) for local runs. In production, set these
# in the Vercel project's environment settings. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_URL=
REVALIDATE_SECRET=
# Public (anon / publishable) key. Only the live verification check reads it.
SUPABASE_ANON_KEY=

# Phase 4 (optional: the matching endpoint answers 503 until its values are set).
# Random string used to hash visitor IPs for rate limiting (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))").
RATE_LIMIT_SALT=
# Contact form notification: your Gmail address and a Gmail App Password (not your normal password).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Chatbot providers (Groq first, then Gemini).
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides.
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash
