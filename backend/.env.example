# Copy to backend/.env (git-ignored) for local runs. In production, set these
# in the Vercel project's environment settings. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_URL=
REVALIDATE_SECRET=
# Public (anon / publishable) key. Only the live verification check reads it.
SUPABASE_ANON_KEY=
