# Next.js server-side settings. Copy to .env.local (git-ignored) and fill in. Never commit values.

# "supabase" reads site content from Supabase; anything else (or unset) uses src/data/portfolio.ts.
CONTENT_SOURCE=static

# Public read access to published content (project URL and the publishable key, sb_publishable_...).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared with the backend; protects POST /api/revalidate. Send as "Authorization: Bearer <secret>".
REVALIDATE_SECRET=
